# StreetOps AI — Frontend Environment Variables
# -----------------------------------------------
# Copy this to .env and set real values.
# Variables starting with VITE_ are exposed to the browser.
# NEVER put secrets (API keys) in VITE_ variables.

# Only used if you want to override the Vite proxy with a direct URL
# Leave commented out unless you have a specific reason
# VITE_API_BASE_URL=http://localhost:3001
