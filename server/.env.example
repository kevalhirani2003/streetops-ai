# StreetOps AI — Backend Environment Variables
# -----------------------------------------------
# Copy this file to .env and fill in REAL values.
# NEVER commit your .env file to Git.
# NEVER share your actual API key.

# Server port
PORT=3001

# Frontend URL (for CORS — no trailing slash)
CLIENT_URL=http://localhost:5173

# Meta Model API (added in Phase 3)
# Get your key at: https://dev.meta.ai/platform
MODEL_API_KEY=your_meta_api_key_here

# Node environment
NODE_ENV=development
